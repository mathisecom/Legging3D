{%- liquid
  assign s = section.settings
  assign uid = section.id
-%}

{%- style -%}
  .hiw-{{ uid }} {
    --hiw-pad-top: {{ s.padding_top }}px;
    --hiw-pad-bot: {{ s.padding_bottom }}px;
    --hiw-max: {{ s.container_width }}px;
    --hiw-gap: {{ s.column_gap }}px;
    --hiw-bg: {{ s.bg_color }};

    --hiw-eyebrow-color: {{ s.eyebrow_color }};
    --hiw-heading-color: {{ s.heading_color }};
    --hiw-text-color: {{ s.text_color }};

    --hiw-step-bg: {{ s.step_bg_color }};
    --hiw-step-num: {{ s.step_number_color }};
    --hiw-step-title: {{ s.step_title_color }};

    --hiw-tagline-color: {{ s.tagline_color }};
    --hiw-tagline-line: {{ s.tagline_line_color }};

    --hiw-card-bg: {{ s.card_bg_color }};
    --hiw-card-radius: {{ s.card_border_radius }}px;
    --hiw-anno-heading1: {{ s.annotation_heading_color1 }};
    --hiw-anno-heading2: {{ s.annotation_heading_color2 }};
    --hiw-anno-title: {{ s.annotation_title_color }};
    --hiw-anno-text: {{ s.annotation_text_color }};
    --hiw-divider: {{ s.divider_color }};
    --hiw-dot: {{ s.dot_color }};

    --hiw-heading-size: {{ s.heading_size }}px;
    --hiw-anno-heading-size: {{ s.annotation_heading_size }}px;

    background: var(--hiw-bg);
    padding: var(--hiw-pad-top) 20px var(--hiw-pad-bot);
    font-family: inherit;
  }

  .hiw-{{ uid }} *,
  .hiw-{{ uid }} *::before,
  .hiw-{{ uid }} *::after { box-sizing: border-box; }

  .hiw-{{ uid }}__wrapper {
    max-width: {% if s.full_width %}100%{% else %}var(--hiw-max){% endif %};
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--hiw-gap);
    align-items: center;
  }
  .hiw-{{ uid }}--reverse .hiw-{{ uid }}__wrapper { direction: rtl; }
  .hiw-{{ uid }}--reverse .hiw-{{ uid }}__left,
  .hiw-{{ uid }}--reverse .hiw-{{ uid }}__right { direction: ltr; }

  /* ===== LEFT COLUMN ===== */
  .hiw-{{ uid }}__left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hiw-{{ uid }}__eyebrow {
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--hiw-eyebrow-color);
    font-weight: 600;
    font-style: italic;
    font-family: inherit;
    margin: 0;
  }

  .hiw-{{ uid }}__heading {
    font-size: var(--hiw-heading-size);
    line-height: 1.1;
    color: var(--hiw-heading-color);
    margin: 0;
    font-weight: 400;
    font-family: inherit;
  }

  .hiw-{{ uid }}__description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--hiw-text-color);
    margin: 0;
  }
  .hiw-{{ uid }}__description p { margin: 0 0 0.8em; }
  .hiw-{{ uid }}__description p:last-child { margin-bottom: 0; }

  .hiw-{{ uid }}__steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 8px;
  }

  .hiw-{{ uid }}__step {
    background: var(--hiw-step-bg);
    padding: 18px 24px;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    align-items: start;
  }

  .hiw-{{ uid }}__step-number {
    font-size: 48px;
    font-weight: 400;
    color: var(--hiw-step-num);
    line-height: 1;
    font-family: inherit;
  }

  .hiw-{{ uid }}__step-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 4px;
  }

  .hiw-{{ uid }}__step-title {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hiw-step-title);
    font-weight: 600;
    margin: 0;
    font-family: inherit;
  }

  .hiw-{{ uid }}__step-description {
    font-size: 14px;
    line-height: 1.55;
    color: var(--hiw-text-color);
    margin: 0;
  }

  .hiw-{{ uid }}__tagline {
    display: flex;
    align-items: stretch;
    gap: 14px;
    margin-top: 8px;
    font-size: 14px;
    color: var(--hiw-tagline-color);
    font-style: italic;
    line-height: 1.4;
  }
  .hiw-{{ uid }}__tagline-line {
    width: 2px;
    background: var(--hiw-tagline-line);
    flex-shrink: 0;
  }

  /* ===== RIGHT COLUMN — CARD ===== */
  .hiw-{{ uid }}__card {
    background: var(--hiw-card-bg);
    border-radius: var(--hiw-card-radius);
    padding: 32px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: center;
  }

  .hiw-{{ uid }}__image-area {
    position: relative;
    width: 100%;
  }
  .hiw-{{ uid }}__image-area img,
  .hiw-{{ uid }}__image-area svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .hiw-{{ uid }}__dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hiw-dot);
    transform: translate(-50%, -50%);
    z-index: 2;
    box-shadow: 0 0 0 4px rgba(0,0,0,0.06);
  }

  .hiw-{{ uid }}__annotations-area {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-left: 8px;
  }

  .hiw-{{ uid }}__anno-heading {
    margin: 0;
    line-height: 1.05;
    font-family: inherit;
    font-weight: 400;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hiw-{{ uid }}__anno-heading-1 {
    font-size: var(--hiw-anno-heading-size);
    color: var(--hiw-anno-heading1);
  }
  .hiw-{{ uid }}__anno-heading-2 {
    font-size: var(--hiw-anno-heading-size);
    color: var(--hiw-anno-heading2);
    font-style: italic;
  }

  .hiw-{{ uid }}__divider {
    height: 1px;
    width: 100%;
    background: var(--hiw-divider);
    margin: 0;
  }

  .hiw-{{ uid }}__anno-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hiw-{{ uid }}__anno-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hiw-{{ uid }}__anno-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--hiw-anno-title);
    margin: 0;
    font-family: inherit;
    line-height: 1.2;
  }

  .hiw-{{ uid }}__anno-text {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--hiw-anno-text);
    margin: 0;
  }

  /* ===== TABLET ===== */
  @media (min-width: 750px) and (max-width: 989px) {
    .hiw-{{ uid }}__wrapper,
    .hiw-{{ uid }}--reverse .hiw-{{ uid }}__wrapper {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 40px;
    }
    .hiw-{{ uid }}__heading { font-size: calc(var(--hiw-heading-size) * 0.85); }
    .hiw-{{ uid }}__card { padding: 24px; }
  }

  /* ===== MOBILE ===== */
  @media (max-width: 749px) {
    .hiw-{{ uid }} {
      padding: calc(var(--hiw-pad-top) * 0.6) 14px calc(var(--hiw-pad-bot) * 0.6);
    }
    .hiw-{{ uid }}__wrapper,
    .hiw-{{ uid }}--reverse .hiw-{{ uid }}__wrapper {
      grid-template-columns: 1fr;
      direction: ltr;
      gap: 32px;
    }
    .hiw-{{ uid }}__heading {
      font-size: calc(var(--hiw-heading-size) * 0.65);
    }
    .hiw-{{ uid }}__step {
      padding: 14px 16px;
      grid-template-columns: 40px 1fr;
      gap: 12px;
    }
    .hiw-{{ uid }}__step-number { font-size: 34px; }
    .hiw-{{ uid }}__card {
      grid-template-columns: 1fr;
      padding: 18px;
      gap: 22px;
    }
    .hiw-{{ uid }}__annotations-area { padding-left: 0; }
    .hiw-{{ uid }}__anno-heading-1,
    .hiw-{{ uid }}__anno-heading-2 {
      font-size: calc(var(--hiw-anno-heading-size) * 0.75);
    }
  }
{%- endstyle -%}

<div class="hiw-{{ uid }}{% if s.image_position == 'left' %} hiw-{{ uid }}--reverse{% endif %}">
  <div class="hiw-{{ uid }}__wrapper">

    {%- comment -%} ===== LEFT COLUMN ===== {%- endcomment -%}
    <div class="hiw-{{ uid }}__left">

      {%- if s.eyebrow_text != blank -%}
        <p class="hiw-{{ uid }}__eyebrow">{{ s.eyebrow_text }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="hiw-{{ uid }}__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.description != blank -%}
        <div class="hiw-{{ uid }}__description">{{ s.description }}</div>
      {%- endif -%}

      {%- assign has_steps = false -%}
      {%- for b in section.blocks -%}
        {%- if b.type == 'step' -%}{%- assign has_steps = true -%}{%- endif -%}
      {%- endfor -%}

      {%- if has_steps -%}
        <div class="hiw-{{ uid }}__steps">
          {%- assign step_idx = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              {%- assign step_idx = step_idx | plus: 1 -%}
              <div class="hiw-{{ uid }}__step" {{ block.shopify_attributes }}>
                <div class="hiw-{{ uid }}__step-number">{{ step_idx }}</div>
                <div class="hiw-{{ uid }}__step-content">
                  {%- if block.settings.title != blank -%}
                    <h3 class="hiw-{{ uid }}__step-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="hiw-{{ uid }}__step-description">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if s.tagline_text != blank -%}
        <div class="hiw-{{ uid }}__tagline">
          {%- if s.show_tagline_line -%}
            <span class="hiw-{{ uid }}__tagline-line" aria-hidden="true"></span>
          {%- endif -%}
          <span>{{ s.tagline_text }}</span>
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} ===== RIGHT COLUMN — CARD ===== {%- endcomment -%}
    <div class="hiw-{{ uid }}__right">
      <div class="hiw-{{ uid }}__card">

        <div class="hiw-{{ uid }}__image-area">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '300, 500, 700, 900, 1200',
                sizes: '(max-width: 749px) 100vw, 30vw',
                alt: s.image.alt | default: s.heading
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}

          {%- if s.show_dots -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'annotation' -%}
                <span class="hiw-{{ uid }}__dot"
                      style="left: {{ block.settings.dot_x }}%; top: {{ block.settings.dot_y }}%;"
                      aria-hidden="true"></span>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="hiw-{{ uid }}__annotations-area">
          {%- if s.anno_heading_1 != blank or s.anno_heading_2 != blank -%}
            <h3 class="hiw-{{ uid }}__anno-heading">
              {%- if s.anno_heading_1 != blank -%}
                <span class="hiw-{{ uid }}__anno-heading-1">{{ s.anno_heading_1 }}</span>
              {%- endif -%}
              {%- if s.anno_heading_2 != blank -%}
                <span class="hiw-{{ uid }}__anno-heading-2">{{ s.anno_heading_2 }}</span>
              {%- endif -%}
            </h3>
          {%- endif -%}

          {%- if s.show_divider -%}
            <div class="hiw-{{ uid }}__divider" aria-hidden="true"></div>
          {%- endif -%}

          <div class="hiw-{{ uid }}__anno-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'annotation' -%}
                <div class="hiw-{{ uid }}__anno-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.title != blank -%}
                    <h4 class="hiw-{{ uid }}__anno-title">{{ block.settings.title }}</h4>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <p class="hiw-{{ uid }}__anno-text">{{ block.settings.description }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Comment ça marche",
  "tag": "section",
  "class": "section-how-it-works",
  "settings": [
    { "type": "header", "content": "Mise en page" },
    { "type": "checkbox", "id": "full_width", "label": "Pleine largeur", "default": false },
    { "type": "select", "id": "image_position", "label": "Position de la carte image",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "right", "label": "Droite" }
      ], "default": "right"
    },
    { "type": "range", "id": "container_width", "label": "Largeur maximale",
      "min": 900, "max": 1800, "step": 20, "unit": "px", "default": 1400 },
    { "type": "range", "id": "column_gap", "label": "Espace entre colonnes",
      "min": 20, "max": 150, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top", "label": "Espacement haut",
      "min": 0, "max": 200, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacement bas",
      "min": 0, "max": 200, "step": 5, "unit": "px", "default": 80 },
    { "type": "color", "id": "bg_color", "label": "Couleur de fond de la section", "default": "#ffffff" },

    { "type": "header", "content": "Colonne texte — En-tête" },
    { "type": "text", "id": "eyebrow_text", "label": "Sur-titre", "default": "COMMENT CA MARCHE ?" },
    { "type": "color", "id": "eyebrow_color", "label": "Couleur du sur-titre", "default": "#6b1f3a" },
    { "type": "text", "id": "heading", "label": "Titre principal", "default": "Une conception innovante" },
    { "type": "range", "id": "heading_size", "label": "Taille du titre",
      "min": 24, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "color", "id": "heading_color", "label": "Couleur du titre", "default": "#1a1a2e" },
    { "type": "richtext", "id": "description", "label": "Description",
      "default": "<p>Nous avons conçu le legging anti-cellulite le plus abouti. Il allie stimulation de la circulation, drainage doux, compression légère et effet push-up, pour une peau visiblement plus lisse, et une silhouette mise en valeur.</p>" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte courant", "default": "#333333" },

    { "type": "header", "content": "Colonne texte — Style des étapes" },
    { "type": "color", "id": "step_bg_color", "label": "Fond des cartes étape", "default": "#fce8e0" },
    { "type": "color", "id": "step_number_color", "label": "Couleur des numéros", "default": "#6b1f3a" },
    { "type": "color", "id": "step_title_color", "label": "Couleur des titres d'étape", "default": "#6b1f3a" },

    { "type": "header", "content": "Colonne texte — Phrase signature" },
    { "type": "text", "id": "tagline_text", "label": "Texte signature",
      "default": "Leonie & Co : le legging qui sublime vos courbes et booste votre confiance." },
    { "type": "checkbox", "id": "show_tagline_line", "label": "Afficher le trait vertical à gauche", "default": true },
    { "type": "color", "id": "tagline_color", "label": "Couleur du texte signature", "default": "#6b1f3a" },
    { "type": "color", "id": "tagline_line_color", "label": "Couleur du trait", "default": "#6b1f3a" },

    { "type": "header", "content": "Carte image — Apparence" },
    { "type": "image_picker", "id": "image", "label": "Image principale" },
    { "type": "color", "id": "card_bg_color", "label": "Fond de la carte", "default": "#f5f0eb" },
    { "type": "range", "id": "card_border_radius", "label": "Arrondi de la carte",
      "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },

    { "type": "header", "content": "Carte image — Titre" },
    { "type": "text", "id": "anno_heading_1", "label": "Titre — ligne 1", "default": "Sens-toi" },
    { "type": "color", "id": "annotation_heading_color1", "label": "Couleur ligne 1", "default": "#1a1a2e" },
    { "type": "text", "id": "anno_heading_2", "label": "Titre — ligne 2 (italique)", "default": "Sexy et Confiante" },
    { "type": "color", "id": "annotation_heading_color2", "label": "Couleur ligne 2", "default": "#6b1f3a" },
    { "type": "range", "id": "annotation_heading_size", "label": "Taille du titre",
      "min": 22, "max": 60, "step": 1, "unit": "px", "default": 34 },
    { "type": "checkbox", "id": "show_divider", "label": "Afficher la ligne séparatrice", "default": true },
    { "type": "color", "id": "divider_color", "label": "Couleur de la ligne séparatrice", "default": "#d4a99e" },

    { "type": "header", "content": "Carte image — Annotations & points" },
    { "type": "color", "id": "annotation_title_color", "label": "Couleur des titres d'annotation", "default": "#6b1f3a" },
    { "type": "color", "id": "annotation_text_color", "label": "Couleur du texte d'annotation", "default": "#444444" },
    { "type": "checkbox", "id": "show_dots", "label": "Afficher les points sur l'image", "default": true },
    { "type": "color", "id": "dot_color", "label": "Couleur des points", "default": "#c2476a" }
  ],

  "blocks": [
    {
      "type": "step",
      "name": "Étape (colonne gauche)",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "TITRE DE L'ÉTAPE" },
        { "type": "textarea", "id": "description", "label": "Description",
          "default": "Description de cette étape avec quelques détails utiles pour le client." }
      ]
    },
    {
      "type": "annotation",
      "name": "Annotation (carte image)",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Bénéfice" },
        { "type": "textarea", "id": "description", "label": "Description",
          "default": "Petit descriptif de ce bénéfice." },
        { "type": "header", "content": "Position du point sur l'image" },
        { "type": "range", "id": "dot_x", "label": "Position horizontale",
          "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "dot_y", "label": "Position verticale",
          "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],

  "max_blocks": 12,

  "presets": [
    {
      "name": "Comment ça marche",
      "category": "Texte",
      "blocks": [
        { "type": "step", "settings": {
          "title": "TECHNOLOGIE 3D DRAINANTE",
          "description": "Les lignes 3D, positionnées sur les cuisses et les fessiers, créent un léger massage qui stimule naturellement la circulation sanguine et aide à activer le drainage de la cellulite."
        }},
        { "type": "step", "settings": {
          "title": "UNE COMPRESSION DOUCE",
          "description": "La matière épouse parfaitement le corps et exerce une légère pression sur les jambes. Cette compression douce stimule la tonicité et apporte une sensation de maintien agréable tout au long de la journée."
        }},
        { "type": "step", "settings": {
          "title": "EFFET PUSH-UP SCULPTANT",
          "description": "Une structure gainante qui affine les jambes, accompagnée d'un léger plissé, qui réhausse et galbe naturellement les fesses, pour une silhouette instantanément plus harmonieuse et plus sexy."
        }},
        { "type": "annotation", "settings": {
          "title": "Réduit la cellulite",
          "description": "Grâce à des lignes 3D qui stimulent les cellules graisseuses.",
          "dot_x": 62, "dot_y": 28
        }},
        { "type": "annotation", "settings": {
          "title": "Opaque & Push-up",
          "description": "Couvre l'aspect de la cellulite et galbe le fessier.",
          "dot_x": 42, "dot_y": 48
        }},
        { "type": "annotation", "settings": {
          "title": "Tonifie les jambes & les fesses",
          "description": "Compression douce qui stimule les muscles.",
          "dot_x": 52, "dot_y": 75
        }}
      ]
    }
  ]
}
{% endschema %}